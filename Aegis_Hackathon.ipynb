# Write server.py
server_code = r'''
"""
Aegis — FastAPI Server
Endpoints:
  GET  /               → serves the demo frontend HTML
  GET  /health         → health check
  POST /api/crisis     → run full 7-agent pipeline (returns JSON)
  GET  /api/stream     → SSE stream of agent activations
  POST /api/forecast   → ML-only forecast (no LLM)
  GET  /api/status     → system status

Run locally:  uvicorn api.server:app --reload --port 8000
Run in Colab: see AEGIS_COLAB.py (cell 3)
"""

import asyncio
import json
import os
import sys
from datetime import datetime
from typing import AsyncGenerator

from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import HTMLResponse, StreamingResponse
from pydantic import BaseModel, Field

# Add project root to path so imports work from Colab
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from agents.swarm import run_aegis_pipeline
from models.forecaster import get_forecaster

# ── App ──────────────────────────────────────────────────────────────────────

app = FastAPI(
    title="Aegis",
    description="Autonomous agentic crisis management system — AMD Hackathon Demo",
    version="1.0.0",
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)


# ── Request / Response schemas ───────────────────────────────────────────────

class CrisisEvent(BaseModel):
    oil_price_change_pct: float = Field(default=18.0, description="% change in oil price")
    shipping_disruption:  str   = Field(default="Strait of Hormuz — tanker reroutes detected")
    news_headline:        str   = Field(default="Regional conflict escalation near Persian Gulf")
    severity:             str   = Field(default="HIGH")
    disruption_factor:    float = Field(default=0.7, ge=0, le=1, description="Supply friction 0–1")
    horizon_days:         int   = Field(default=14, ge=1, le=90)


class ForecastRequest(BaseModel):
    oil_shock_pct:     float = Field(default=0.0)
    disruption_factor: float = Field(default=0.0, ge=0, le=1)
    horizon_days:      int   = Field(default=14, ge=1, le=90)


# ── Startup: pre-warm the forecaster ─────────────────────────────────────────

@app.on_event("startup")
async def startup_event():
    print("🛡️  Aegis starting up...")
    try:
        get_forecaster()   # fits model on synthetic data
        print("✅ Forecaster ready")
    except Exception as e:
        print(f"⚠️  Forecaster startup warning: {e}")


# ── Endpoints ─────────────────────────────────────────────────────────────────

@app.get("/health")
async def health():
    return {
        "status": "online",
        "system": "Aegis",
        "timestamp": datetime.utcnow().isoformat(),
        "agents": 7,
        "model": "ARIMA+XGBoost + Groq LLaMA-3.1-70B",
    }


@app.post("/api/forecast")
async def forecast_only(req: ForecastRequest):
    """Run ML forecast without triggering the full agent pipeline."""
    try:
        fc = get_forecaster()
        result = fc.forecast(
            horizon_days=req.horizon_days,
            crisis_shock=req.oil_shock_pct,
            disruption_factor=req.disruption_factor,
        )
        return {"success": True, "data": result}
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.post("/api/crisis")
async def run_crisis(event: CrisisEvent):
    """
    Full 7-agent pipeline:
      1. Run ML forecast
      2. Pass to agent swarm (Groq LLM)
      3. Return complete analysis
    """
    try:
        # Step 1: ML forecast
        fc = get_forecaster()
        forecast_data = fc.forecast(
            horizon_days=event.horizon_days,
            crisis_shock=event.oil_price_change_pct,
            disruption_factor=event.disruption_factor,
        )

        # Step 2: Agent swarm
        event_dict = event.model_dump()
        results = await run_aegis_pipeline(event_dict, forecast_data)

        return {
            "success":   True,
            "timestamp": datetime.utcnow().isoformat(),
            "data":      results,
        }

    except Exception as e:
        import traceback
        raise HTTPException(status_code=500, detail=f"{str(e)}\n{traceback.format_exc()}")


@app.get("/api/stream")
async def stream_crisis(
    oil_change: float = 18.0,
    disruption: float = 0.7,
    severity:   str   = "HIGH",
):
    """
    Server-Sent Events stream of agent activations.
    Connect with EventSource in JavaScript for live updates.
    """
    async def event_generator() -> AsyncGenerator[str, None]:
        # Yield SSE format: "data: {json}\n\n"
        def sse(payload: dict) -> str:
            return f"data: {json.dumps(payload)}\n\n"

        yield sse({"type": "start", "message": "Aegis pipeline initiated"})

        try:
            fc = get_forecaster()
            forecast_data = fc.forecast(
                horizon_days=14,
                crisis_shock=oil_change,
                disruption_factor=disruption,
            )
            yield sse({"type": "forecast_ready", "data": forecast_data["summary"]})

            event_dict = {
                "oil_price_change_pct": oil_change,
                "shipping_disruption":  "Strait of Hormuz disruption detected",
                "news_headline":        "Geopolitical escalation near Persian Gulf",
                "severity":             severity,
                "disruption_factor":    disruption,
            }

            # Import individual agents for streaming
            from agents.swarm import (
                signal_agent, intelligence_agent, forecast_agent,
                simulation_agent, decision_agent, alert_agent, execution_agent,
            )

            yield sse({"type": "agent_start", "agent": "signal", "index": 1})
            sig = await signal_agent(event_dict)
            yield sse({"type": "agent_done", "agent": "signal", "data": sig})

            yield sse({"type": "agent_start", "agent": "intelligence", "index": 2})
            intel = await intelligence_agent(sig, event_dict)
            yield sse({"type": "agent_done", "agent": "intelligence", "data": intel})

            yield sse({"type": "agent_start", "agent": "forecast", "index": 3})
            fore = await forecast_agent(intel, forecast_data)
            yield sse({"type": "agent_done", "agent": "forecast", "data": fore})

            yield sse({"type": "agent_start", "agent": "simulation", "index": 4})
            sim = await simulation_agent(fore, event_dict)
            yield sse({"type": "agent_done", "agent": "simulation", "data": sim})

            yield sse({"type": "agent_start", "agent": "decision", "index": 5})
            dec = await decision_agent(sim, fore, intel)
            yield sse({"type": "agent_done", "agent": "decision", "data": dec})

            yield sse({"type": "agent_start", "agent": "alert", "index": 6})
            alert = await alert_agent(dec, fore)
            yield sse({"type": "agent_done", "agent": "alert", "data": alert})

            yield sse({"type": "agent_start", "agent": "execution", "index": 7})
            exe = await execution_agent(dec)
            yield sse({"type": "agent_done", "agent": "execution", "data": exe})

            yield sse({
                "type":    "complete",
                "message": "All 7 agents completed",
                "summary": dec.get("executive_summary", ""),
                "threat":  dec.get("threat_level", ""),
            })

        except Exception as e:
            yield sse({"type": "error", "message": str(e)})

    return StreamingResponse(
        event_generator(),
        media_type="text/event-stream",
        headers={
            "Cache-Control": "no-cache",
            "X-Accel-Buffering": "no",
        },
    )


@app.get("/api/status")
