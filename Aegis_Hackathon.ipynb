import threading, time, subprocess, sys, urllib.request, json
from pyngrok import ngrok, conf

# Fix model name in all files
for f in ["/content/aegis/agents/swarm.py", "/content/aegis/api/server.py"]:
    try:
        content = open(f).read()
        content = content.replace("llama-3.1-70b-versatile","llama-3.3-70b-versatile")
        open(f,"w").write(content)
    except: pass

# Kill any existing server
subprocess.run(["pkill","-f","uvicorn"],capture_output=True)
subprocess.run(["fuser","-k","8000/tcp"],capture_output=True)
time.sleep(2)

def run_server():
    import os
    env = os.environ.copy()
    env["PYTHONPATH"] = "/content/aegis"
    r = subprocess.run([
        sys.executable,"-m","uvicorn","api.server:app",
        "--host","0.0.0.0","--port","8000","--log-level","warning",
    ], cwd="/content/aegis", capture_output=True, text=True, env=env)
    if r.returncode != 0:
        print("❌ Server error:", r.stderr[-800:])

threading.Thread(target=run_server, daemon=True).start()

print("⏳ Waiting for server...")
for i in range(20):
    time.sleep(1)
    try:
        urllib.request.urlopen("http://localhost:8000/health",timeout=2)
        print(f"✅ Server up in {i+1}s")
        break
    except:
        print(f"   [{i+1}/20] waiting...")

# Connect ngrok
conf.get_default().auth_token = NGROK_TOKEN
